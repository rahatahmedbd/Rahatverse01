# ==========================================
# RahatVerse - Environment Variables
# Copy this file to .env.local and fill values
# ==========================================

# ── App ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RahatVerse
NODE_ENV=development

# ── Analytics (Phase 26) ─────────────────
# Optional. Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
# When empty, only first-party analytics (/api/analytics) are collected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Supabase ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Cloudinary ───────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Rahat AI Assistant (chat widget + bottom-nav AI button) ──
# Both providers offer FREE API keys — no credit card required. Configure
# either one (or both; Gemini is tried first, Groq as backup). When no key is
# set, the assistant still answers common questions from its built-in
# knowledge base, so the feature works out of the box.
#   GEMINI_API_KEY          → get a free key at https://aistudio.google.com/apikey
#   GROQ_API_KEY            → get a free key at https://console.groq.com/keys
# Optional model overrides:
#   GEMINI_MODEL=gemini-2.0-flash
#   GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Newsletter (Phase 27) ────────────────────
# Double opt-in confirmation expiry is 48h. No extra env required for mock email.
# Set a real provider in Phase 29 (Resend/SendGrid) to deliver actual emails.
# ENABLE_EMAIL_LOG=true  # set to log mock emails in production

# ── Email (Phase 29 — transactional notifications) ─────
# Resend is the production email provider. Verify the sending domain in Resend.
# If RESEND_API_KEY / EMAIL_FROM are empty, the app falls back to safe mock
# (logged) delivery so local and preview builds never fail.
RESEND_API_KEY=re_xxx
EMAIL_FROM="RahatVerse <noreply@your-verified-domain.com>"
# Recipient for contact and order notifications.
ADMIN_EMAIL=owner@your-verified-domain.com
# Resend webhook signing secret. Configure /api/email/webhook in Resend.
RESEND_WEBHOOK_SECRET=whsec_xxx
# Secret used by Vercel Cron to dispatch scheduled newsletter campaigns.
CRON_SECRET=generate_a_long_random_secret

# ── Testing (Phase 30) ─────────────────────────────────
# Unit + integration tests (Vitest) run with no backend and mock Supabase/email.
#   npm test            # run tests once
#   npm run test:coverage
# End-to-end tests (Playwright) start a production server automatically:
#   npx playwright install chromium && npm run e2e
